{
  "name": "grafica-os",
  "version": "1.0.0",
  "description": "Sistema para gestão de uma gráfica: orçamentos, ordens de serviço, pagamentos, estoque e relatórios.",
  "main": "main.js",
  "scripts": {
    "dev": "echo Nenhum dev configurado",
    "css": "tailwindcss -i ./src/public/css/tailwind.input.css -o ./src/public/css/tailwind.css --minify",
    "electron": "electron .",
    "start": "electron .",
    "dist": "npm run css && electron-builder --win",
    "test": "node --test \"tests/unit/*.test.js\"",
    "test:e2e": "node tests/e2e/executar.js",
    "test:tudo": "npm test && npm run test:e2e"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ti-vitor-assis/grafica-os.git"
  },
  "keywords": [
    "GRAFICA",
    "ORDEM",
    "DE",
    "SERVIÇO",
    "GERENCIAMENTO",
    "CLIENTES"
  ],
  "author": "Vitor de Assis Passos",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/ti-vitor-assis/grafica-os/issues"
  },
  "homepage": "https://github.com/ti-vitor-assis/grafica-os#readme",
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "dotenv": "^18.0.9",
    "exceljs": "4.4.0",
    "mongoose": "^8.24.8"
  },
  "devDependencies": {
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "mongodb-memory-server": "^10.4.3",
    "rcedit": "5.0.2",
    "tailwindcss": "^3.4.19"
  },
  "build": {
    "appId": "br.senac.graficaos",
    "productName": "Gráfica OS",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!.env",
      "!.env.*",
      "!dist/**",
      "!tailwind.config.js",
      "!src/public/css/tailwind.input.css",
      "!**/*.map",
      "!tests/**",
      "!docs/**",
      "!scripts/**"
    ],
    "win": {
      "target": "nsis",
      "signAndEditExecutable": false,
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "shortcutName": "Gráfica OS",
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "installerHeaderIcon": "build/icon.ico"
    },
    "afterPack": "scripts/icone-exe.js"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
